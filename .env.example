# LOCAL DEVELOPMENT ONLY
SECRET_KEY=change-this-for-local-development
SESSION_COOKIE_SECURE=0

# PRODUCTION (Render): REQUIRED. Paste the Neon PostgreSQL connection string.
# Example format only; NEVER commit a real credential to GitHub:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# SQLite is intentionally local-only. Render will refuse to start with SQLite
# because Render's filesystem is ephemeral and finance data could disappear.
SQLITE_PATH=database.db

# Gemini AI (recommended on Render)
# Use ONE API key variable. GEMINI_API_KEY is preferred here.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Stable default used by the app; change only if your project requires another model.
GEMINI_MODEL=gemini-3.5-flash
# Keep disabled: when Gemini fails, show the real API error instead of repeating canned finance data.
AI_LOCAL_FALLBACK=0

# Optional one-time migration protection for an OLD single-user database.
# If old rows exist without user_id, only a first registration matching this
# identity may claim them. Leave unset for a brand-new public installation.
# LEGACY_OWNER_EMAIL=you@example.com
# LEGACY_OWNER_USERNAME=yourusername

# Password recovery email (Brevo transactional email)
# Create a free Brevo account, verify the sender email/domain, then add these on Render.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=YARIN
